# ─────────────────────────────────────────────────────────────────────────────
# .gitignore — Pi Assistant
# ─────────────────────────────────────────────────────────────────────────────

# ── Secrets — NEVER commit these ──────────────────────────────────────────
.env

# ── Virtual environment ────────────────────────────────────────────────────
venv/
.venv/
env/

# ── Python artefacts ──────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
dist/
build/
.eggs/

# ── Data directory (persistent state — device-specific) ───────────────────
# Keep the directory structure but ignore actual data files
data/memory/*.db
data/memory/*.db-shm
data/memory/*.db-wal
data/logs/*.log
data/logs/*.log.*

# ── Test artefacts ─────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.tox/

# ── Editor / IDE ───────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
