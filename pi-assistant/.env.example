# ─────────────────────────────────────────────────────────────────────────────
# Pi Assistant — Environment Variables Template
#
# Copy this file to .env and fill in your real values.
# .env is NEVER committed to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Dashboard security ────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
DASHBOARD_SECRET_KEY=replace-with-a-random-64-char-hex-string

# Dashboard login (overrides config.yaml)
DASHBOARD_USERNAME=admin
# Generate hash: python -c "import bcrypt; print(bcrypt.hashpw(b'yourpassword', bcrypt.gensalt()).decode())"
DASHBOARD_PASSWORD_HASH=$2b$12$your_bcrypt_hash_here

# ── AI / LLM provider ─────────────────────────────────────────────────────────
# OpenAI (or compatible provider)
OPENAI_API_KEY=sk-...

# For local Ollama on the Pi (leave OPENAI_API_KEY blank, set these instead):
# AI_BASE_URL=http://localhost:11434/v1
# AI_DEFAULT_MODEL=llama3

# ── External services (add as you integrate them) ─────────────────────────────
# WEATHER_API_KEY=
# GOOGLE_API_KEY=
# HOME_ASSISTANT_URL=http://homeassistant.local:8123
# HOME_ASSISTANT_TOKEN=
